{
  "name": "Bun",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "dev",
  "runArgs": [
    "--cap-drop=ALL"
  ],
  "securityOpt": [
    "no-new-privileges"
  ],
  "init": true,
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent"
  },
  "mounts": [
    // SSH Agent
    "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind",
    // OpenCode Global Config
    "source=/srv/opencode/${localEnv:USER}/config/opencode.jsonc,target=/home/dev/.config/opencode/opencode.jsonc,type=bind,readonly",
    // OpenCode Global Skills
    "source=/srv/opencode/${localEnv:USER}/config/skills,target=/home/dev/.config/opencode/skills,type=bind,readonly",
    // Shared Secrets
    "source=/srv/opencode/${localEnv:USER}/secrets,target=/run/opencode-secrets,type=bind,readonly",
    // OpenCode Project Data
    "source=/srv/opencode/${localEnv:USER}/projects/${localWorkspaceFolderBasename}/data,target=/home/dev/.local/share/opencode,type=bind",
    // Bun Cache
    {
      "source": "${devcontainerId}-bun-install-cache",
      "target": "/home/dev/.bun/install/cache",
      "type": "volume"
    },
    // Bash History
    {
      "source": "${devcontainerId}-bash-history",
      "target": "/home/dev/.local/state/bash",
      "type": "volume"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "oven.bun-vscode"
      ],
      "settings": {
        "bun.runtime": "/usr/local/bin/bun"
      }
    }
  }
}