---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section id="contact" class="mx-auto max-w-6xl px-6 py-24">
  <div
    data-tilt
    class="reveal spotlight-card relative overflow-hidden rounded-3xl border border-line bg-gradient-to-br from-surface-2 via-surface-2 to-indigo-500/[0.07] p-8 shadow-xl sm:p-12"
  >
    <!-- Decorative ambient glows -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-indigo-500/20 blur-3xl"
    ></div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-cyan-500/15 blur-3xl"
    ></div>

    <div class="relative z-10 grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-center">
      <div>
        <SectionHeading
          eyebrow={t.contact.eyebrow}
          title={t.contact.title}
          description={t.contact.description}
        />

        <div class="inline-flex items-center gap-2.5 rounded-full border border-emerald-500/25 bg-emerald-500/10 px-4 py-1.5 text-xs font-semibold text-emerald-700 dark:text-emerald-300">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500 dark:bg-emerald-400"></span>
          </span>
          {t.hero.badge}
        </div>
      </div>

      <div>
        <p class="mb-4 font-display text-sm font-semibold uppercase tracking-wider text-ink-3">
          {t.contact.findMe}
        </p>
        <div class="grid gap-3 sm:grid-cols-1">
          {
            site.socials.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center justify-between rounded-2xl border border-line bg-surface/90 p-4 shadow-xs backdrop-blur-md transition-all duration-200 hover:-translate-y-0.5 hover:border-indigo-500/40 hover:bg-indigo-500/5"
              >
                <div class="flex items-center gap-3.5">
                  <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-500/12 text-indigo-600 transition-colors group-hover:bg-indigo-500 group-hover:text-white dark:text-indigo-400">
                    <Icon name={social.icon} class="h-5 w-5" />
                  </span>
                  <div>
                    <span class="block font-display font-bold text-ink">
                      {social.name}
                    </span>
                    <span class="font-mono text-xs text-ink-4">
                      {social.url.replace(/^https?:\/\//, '')}
                    </span>
                  </div>
                </div>
                <span class="flex h-9 w-9 items-center justify-center rounded-xl border border-line bg-surface-2 text-ink-3 transition-all group-hover:border-indigo-500/30 group-hover:text-indigo-600 dark:group-hover:text-indigo-300">
                  <Icon
                    name="arrow-up-right"
                    class="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  />
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
