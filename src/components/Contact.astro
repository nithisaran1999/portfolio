---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section id="contact" class="mx-auto max-w-6xl px-6 py-24">
  <div class="reveal">
    <SectionHeading
      eyebrow={t.contact.eyebrow}
      title={t.contact.title}
      description={t.contact.description}
    />
  </div>

  <div class="reveal">
    <div class="rounded-2xl border border-line bg-surface-2 p-7">
      <p class="font-display font-semibold text-ink">{t.contact.findMe}</p>
      <div class="mt-4 flex flex-wrap gap-3">
        {
          site.socials
            .map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-xl border border-line bg-slate-900/5 px-4 py-2.5 text-sm font-medium text-ink-2 transition-colors hover:bg-slate-900/10 dark:bg-white/5 dark:hover:bg-white/10"
              >
                <Icon name={social.icon} class="h-5 w-5" />
                {social.name}
              </a>
            ))
        }
      </div>
    </div>
  </div>
</section>
