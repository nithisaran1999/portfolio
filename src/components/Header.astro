---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

const navLinks = [
  { href: '#about', id: 'about', label: t.nav.about },
  { href: '#approach', id: 'approach', label: t.nav.how },
  { href: '#skills', id: 'skills', label: t.nav.skills },
  { href: '#projects', id: 'projects', label: t.nav.projects },
  { href: '#experience', id: 'experience', label: t.nav.experience },
  { href: '#contact', id: 'contact', label: t.nav.contact },
];

const langActive =
  'rounded-lg bg-gradient-to-r from-indigo-500 to-violet-500 px-2.5 py-1 text-xs font-semibold text-white shadow-xs shadow-indigo-500/25';
const langInactive =
  'rounded-lg px-2.5 py-1 text-xs font-medium text-ink-3 transition-colors hover:text-ink';
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 border-b border-line bg-surface/80 backdrop-blur-xl transition-all duration-300"
>
  <!-- Top Reading Progress Bar -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[2px] bg-transparent">
    <div
      data-scroll-progress
      class="h-full w-0 bg-gradient-to-r from-indigo-500 via-violet-500 to-cyan-400 shadow-[0_0_10px_rgba(99,102,241,0.8)] transition-[width] duration-75"
    ></div>
  </div>

  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6 sm:py-3.5"
    aria-label="Main"
  >
    <!-- Brand Logo -->
    <a
      href="#top"
      class="group flex shrink-0 items-center gap-2.5 font-display text-base font-bold tracking-tight text-ink sm:text-lg"
    >
      <span class="relative flex h-8 w-8 shrink-0 items-center justify-center overflow-hidden rounded-xl ring-1 ring-slate-900/10 transition-transform duration-300 group-hover:scale-105 dark:ring-white/15">
        <img
          src="/favicon.svg"
          alt=""
          width="32"
          height="32"
          class="h-full w-full object-cover"
        />
      </span>
      <span class="whitespace-nowrap">
        <span class="text-gradient">{site.name.split(' ')[0]}</span><span class="text-indigo-500">.</span>
      </span>
    </a>

    <!-- Desktop Navigation Pill (lg and up so 6 items never wrap or squish) -->
    <ul class="hidden items-center gap-0.5 rounded-full border border-line bg-surface-2/70 p-1 shadow-xs backdrop-blur-md lg:flex xl:gap-1">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              data-nav-link={link.id}
              class="nav-pill relative block whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-medium text-ink-2 transition-all duration-200 hover:text-ink xl:px-3.5 xl:text-sm dark:hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Right Controls -->
    <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
      <!-- Theme Toggle -->
      <button
        type="button"
        data-theme-toggle
        aria-label={t.theme.toggle}
        class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-line bg-surface-2/70 text-ink-2 transition-all hover:border-indigo-500/40 hover:bg-indigo-500/10 hover:text-indigo-500 dark:hover:text-indigo-300"
      >
        <Icon name="sun" class="hidden h-4 w-4 dark:block" />
        <Icon name="moon" class="h-4 w-4 dark:hidden" />
      </button>

      <!-- Language Switcher (visible on sm+ directly in navbar) -->
      <div class="hidden items-center rounded-xl border border-line bg-surface-2/70 p-0.5 sm:flex">
        <a href="/" class={lang === 'en' ? langActive : langInactive} data-locale-link>EN</a>
        <a href="/th/" class={lang === 'th' ? langActive : langInactive} data-locale-link>ไทย</a>
      </div>

      <!-- Mobile & Tablet Hamburger Toggle (< lg) -->
      <button
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-line bg-surface-2/70 text-ink-2 transition-colors hover:border-indigo-500/40 hover:bg-indigo-500/10 hover:text-indigo-500 lg:hidden dark:hover:text-indigo-300"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-nav-menu"
        data-nav-toggle
      >
        <span data-icon-open>
          <Icon name="menu" class="h-5 w-5" />
        </span>
        <span data-icon-close class="hidden">
          <Icon name="close" class="h-5 w-5" />
        </span>
      </button>
    </div>
  </nav>

  <!-- Mobile & Tablet Dropdown Menu (< lg) -->
  <div
    id="mobile-nav-menu"
    class="hidden border-t border-line bg-surface/95 shadow-2xl backdrop-blur-2xl lg:hidden"
    data-nav-menu
  >
    <div class="mx-auto max-w-6xl px-4 py-4 sm:px-6">
      <ul class="grid grid-cols-1 gap-1 sm:grid-cols-2">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                data-nav-link={link.id}
                class="nav-pill flex items-center justify-between rounded-xl px-3.5 py-2.5 text-sm font-medium text-ink-2 transition-colors hover:bg-indigo-500/10 hover:text-indigo-600 dark:hover:text-indigo-300"
              >
                <span>{link.label}</span>
                <Icon name="arrow-up-right" class="h-4 w-4 opacity-40" />
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Language switcher inside mobile menu for narrow screens (< sm) -->
      <div class="mt-3 flex items-center justify-between border-t border-line pt-3 sm:hidden">
        <span class="text-xs font-medium text-ink-4">
          {lang === 'th' ? 'เปลี่ยนภาษา' : 'Language'}
        </span>
        <div class="flex items-center rounded-xl border border-line bg-surface-2 p-0.5">
          <a href="/" class={lang === 'en' ? langActive : langInactive} data-locale-link>EN</a>
          <a href="/th/" class={lang === 'th' ? langActive : langInactive} data-locale-link>ไทย</a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .nav-pill.is-active {
    background-color: rgba(99, 102, 241, 0.14);
    color: #4f46e5;
    font-weight: 600;
  }
  :global(.dark) .nav-pill.is-active {
    background-color: rgba(129, 140, 248, 0.18);
    color: #a5b4fc;
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-nav-menu]');
  const iconOpen = document.querySelector<HTMLElement>('[data-icon-open]');
  const iconClose = document.querySelector<HTMLElement>('[data-icon-close]');
  const progressBar = document.querySelector<HTMLElement>('[data-scroll-progress]');
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

  const setMenuState = (open: boolean) => {
    if (!menu || !toggle) return;
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  };

  toggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isCurrentlyOpen = !menu?.classList.contains('hidden');
    setMenuState(!isCurrentlyOpen);
  });

  // Close the menu when a link is clicked.
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      setMenuState(false);
    }),
  );

  // Close the menu when clicking outside the header or pressing Escape.
  document.addEventListener('click', (e) => {
    if (menu && !menu.classList.contains('hidden') && header && !header.contains(e.target as Node)) {
      setMenuState(false);
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      setMenuState(false);
    }
  });

  // Reset mobile menu state if viewport resizes to desktop (lg: 1024px+).
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) {
      setMenuState(false);
    }
  });

  // Theme toggle.
  const themeToggle = document.querySelector('[data-theme-toggle]');
  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const isDark = root.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Preserve the current section anchor when switching language.
  document.querySelectorAll('[data-locale-link]').forEach((a) => {
    a.addEventListener('click', () => {
      if (window.location.hash) {
        a.setAttribute('href', `${a.getAttribute('href')}${window.location.hash}`);
      }
    });
  });

  // Top scroll progress bar.
  const updateScrollProgress = () => {
    if (!progressBar) return;
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const percent = docHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / docHeight) * 100)) : 0;
    progressBar.style.width = `${percent}%`;
  };

  window.addEventListener('scroll', updateScrollProgress, { passive: true });
  updateScrollProgress();

  // Active Section ScrollSpy.
  const sectionIds = ['about', 'approach', 'skills', 'projects', 'experience', 'contact'];
  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if ('IntersectionObserver' in window && sections.length > 0) {
    const spyObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            navLinks.forEach((link) => {
              const isMatch = link.getAttribute('data-nav-link') === id;
              link.classList.toggle('is-active', isMatch);
            });
          }
        });
      },
      { rootMargin: '-30% 0px -60% 0px' },
    );

    sections.forEach((section) => spyObserver.observe(section));
  }
</script>
