---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

const navLinks = [
  { href: '#about', label: t.nav.about },
  { href: '#approach', label: t.nav.how },
  { href: '#skills', label: t.nav.skills },
  { href: '#projects', label: t.nav.projects },
  { href: '#experience', label: t.nav.experience },
  { href: '#contact', label: t.nav.contact },
];

const langActive = 'rounded-md bg-indigo-500/90 px-2.5 py-1 text-xs font-semibold text-white';
const langInactive = 'rounded-md px-2.5 py-1 text-xs font-medium text-ink-3 transition-colors hover:text-ink';
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-line bg-surface/80 backdrop-blur-md"
>
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4" aria-label="Main">
    <a href="#top" class="flex items-center gap-2.5 font-display text-lg font-semibold tracking-tight text-ink">
      <img
        src="/favicon.svg"
        alt=""
        width="32"
        height="32"
        class="h-8 w-8 rounded-lg"
      />
      <span class="text-gradient">{site.name.split(' ')[0]}</span><span>.</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-lg px-3 py-2 text-sm font-medium text-ink-2 transition-colors hover:bg-slate-900/5 hover:text-ink dark:hover:bg-white/5 dark:hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-theme-toggle
        aria-label={t.theme.toggle}
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-ink-2 transition-colors hover:bg-slate-900/5 hover:text-ink dark:hover:bg-white/5 dark:hover:text-white"
      >
        <Icon name="sun" class="hidden h-5 w-5 dark:block" />
        <Icon name="moon" class="h-5 w-5 dark:hidden" />
      </button>

      <div class="hidden items-center rounded-lg border border-line p-0.5 md:flex">
        <a href="/" class={lang === 'en' ? langActive : langInactive} data-locale-link>EN</a>
        <a href="/th/" class={lang === 'th' ? langActive : langInactive} data-locale-link>ไทย</a>
      </div>

      <button
        type="button"
        class="inline-flex items-center justify-center rounded-lg p-2 text-ink-2 transition-colors hover:bg-slate-900/5 dark:hover:bg-white/5 md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
        data-nav-toggle
      >
        <Icon name="menu" class="h-6 w-6" />
      </button>
    </div>
  </nav>

  <div class="hidden border-t border-line md:hidden" data-nav-menu>
    <ul class="space-y-1 px-6 py-4">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-lg px-3 py-2 text-sm font-medium text-ink-2 transition-colors hover:bg-slate-900/5 dark:hover:bg-white/5"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="flex items-center gap-2 border-t border-line pt-4">
        <div class="flex items-center rounded-lg border border-line p-0.5">
          <a href="/" class={lang === 'en' ? langActive : langInactive} data-locale-link>EN</a>
          <a href="/th/" class={lang === 'th' ? langActive : langInactive} data-locale-link>ไทย</a>
        </div>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const menu = document.querySelector('[data-nav-menu]');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  // Close the menu when a link is clicked.
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    }),
  );

  // Theme toggle.
  const themeToggle = document.querySelector('[data-theme-toggle]');
  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const isDark = root.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Preserve the current section anchor when switching language.
  document.querySelectorAll('[data-locale-link]').forEach((a) => {
    a.addEventListener('click', () => {
      if (window.location.hash) {
        a.setAttribute('href', `${a.getAttribute('href')}${window.location.hash}`);
      }
    });
  });
</script>
