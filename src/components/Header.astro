---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

const navLinks = [
  { href: '#about', id: 'about', label: t.nav.about },
  { href: '#approach', id: 'approach', label: t.nav.how },
  { href: '#skills', id: 'skills', label: t.nav.skills },
  { href: '#projects', id: 'projects', label: t.nav.projects },
  { href: '#experience', id: 'experience', label: t.nav.experience },
  { href: '#contact', id: 'contact', label: t.nav.contact },
];

const langActive = 'rounded-md bg-gradient-to-r from-indigo-500 to-violet-500 px-2.5 py-1 text-xs font-semibold text-white shadow-sm shadow-indigo-500/25';
const langInactive = 'rounded-md px-2.5 py-1 text-xs font-medium text-ink-3 transition-colors hover:text-ink';
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 border-b border-line bg-surface/75 backdrop-blur-xl transition-all duration-300"
>
  <!-- Top Reading Progress Bar -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[2px] bg-transparent">
    <div
      data-scroll-progress
      class="h-full w-0 bg-gradient-to-r from-indigo-500 via-violet-500 to-cyan-400 shadow-[0_0_10px_rgba(99,102,241,0.8)] transition-[width] duration-75"
    ></div>
  </div>

  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3.5" aria-label="Main">
    <a
      href="#top"
      class="group flex items-center gap-2.5 font-display text-lg font-bold tracking-tight text-ink"
    >
      <span class="relative flex h-8 w-8 items-center justify-center overflow-hidden rounded-xl ring-1 ring-slate-900/10 transition-transform duration-300 group-hover:scale-105 dark:ring-white/15">
        <img
          src="/favicon.svg"
          alt=""
          width="32"
          height="32"
          class="h-full w-full object-cover"
        />
      </span>
      <span>
        <span class="text-gradient">{site.name.split(' ')[0]}</span><span class="text-indigo-500">.</span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 rounded-full border border-line bg-surface-2/60 p-1 shadow-xs backdrop-blur-md md:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              data-nav-link={link.id}
              class="nav-pill relative rounded-full px-3.5 py-1.5 text-sm font-medium text-ink-2 transition-all duration-200 hover:text-ink dark:hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-theme-toggle
        aria-label={t.theme.toggle}
        class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-line bg-surface-2/60 text-ink-2 transition-all hover:border-indigo-500/40 hover:bg-indigo-500/10 hover:text-indigo-500 dark:hover:text-indigo-300"
      >
        <Icon name="sun" class="hidden h-4 w-4 dark:block" />
        <Icon name="moon" class="h-4 w-4 dark:hidden" />
      </button>

      <div class="hidden items-center rounded-xl border border-line bg-surface-2/60 p-0.5 md:flex">
        <a href="/" class={lang === 'en' ? langActive : langInactive} data-locale-link>EN</a>
        <a href="/th/" class={lang === 'th' ? langActive : langInactive} data-locale-link>ไทย</a>
      </div>

      <button
        type="button"
        class="inline-flex items-center justify-center rounded-xl border border-line bg-surface-2/60 p-2 text-ink-2 transition-colors hover:bg-slate-900/5 dark:hover:bg-white/5 md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
        data-nav-toggle
      >
        <Icon name="menu" class="h-5 w-5" />
      </button>
    </div>
  </nav>

  <div class="hidden border-t border-line bg-surface/95 backdrop-blur-xl md:hidden" data-nav-menu>
    <ul class="space-y-1 px-6 py-4">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              data-nav-link={link.id}
              class="block rounded-xl px-3.5 py-2.5 text-sm font-medium text-ink-2 transition-colors hover:bg-indigo-500/10 hover:text-indigo-600 dark:hover:text-indigo-300"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="flex items-center justify-between border-t border-line pt-4 mt-2">
        <span class="text-xs font-medium text-ink-4">
          {lang === 'th' ? 'ภาษา / Language' : 'Language'}
        </span>
        <div class="flex items-center rounded-xl border border-line bg-surface-2 p-0.5">
          <a href="/" class={lang === 'en' ? langActive : langInactive} data-locale-link>EN</a>
          <a href="/th/" class={lang === 'th' ? langActive : langInactive} data-locale-link>ไทย</a>
        </div>
      </li>
    </ul>
  </div>
</header>

<style>
  .nav-pill.is-active {
    background-color: rgba(99, 102, 241, 0.14);
    color: #4f46e5;
    font-weight: 600;
  }
  :global(.dark) .nav-pill.is-active {
    background-color: rgba(129, 140, 248, 0.18);
    color: #a5b4fc;
  }
</style>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const menu = document.querySelector('[data-nav-menu]');
  const progressBar = document.querySelector<HTMLElement>('[data-scroll-progress]');
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  // Close the menu when a link is clicked.
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    }),
  );

  // Theme toggle.
  const themeToggle = document.querySelector('[data-theme-toggle]');
  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const isDark = root.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Preserve the current section anchor when switching language.
  document.querySelectorAll('[data-locale-link]').forEach((a) => {
    a.addEventListener('click', () => {
      if (window.location.hash) {
        a.setAttribute('href', `${a.getAttribute('href')}${window.location.hash}`);
      }
    });
  });

  // Top scroll progress bar.
  const updateScrollProgress = () => {
    if (!progressBar) return;
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const percent = docHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / docHeight) * 100)) : 0;
    progressBar.style.width = `${percent}%`;
  };

  window.addEventListener('scroll', updateScrollProgress, { passive: true });
  updateScrollProgress();

  // Active Section ScrollSpy.
  const sectionIds = ['about', 'approach', 'skills', 'projects', 'experience', 'contact'];
  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if ('IntersectionObserver' in window && sections.length > 0) {
    const spyObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            navLinks.forEach((link) => {
              const isMatch = link.getAttribute('data-nav-link') === id;
              link.classList.toggle('is-active', isMatch);
            });
          }
        });
      },
      { rootMargin: '-30% 0px -60% 0px' },
    );

    sections.forEach((section) => spyObserver.observe(section));
  }
</script>
