---
import Icon, { type IconName } from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { workApproach } from '../data/site';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

const approachIcons: IconName[] = ['sparkles', 'terminal', 'compass'];
const accentColors = [
  'from-indigo-500/20 to-violet-500/10 text-indigo-600 dark:text-indigo-400',
  'from-cyan-500/20 to-blue-500/10 text-cyan-600 dark:text-cyan-400',
  'from-emerald-500/20 to-teal-500/10 text-emerald-600 dark:text-emerald-400',
];
---

<section id="approach" class="relative mx-auto max-w-6xl px-6 py-24">
  <div class="reveal">
    <SectionHeading
      eyebrow={t.howIWork.eyebrow}
      title={t.howIWork.title}
      description={t.howIWork.description}
    />
  </div>

  <div class="grid gap-6 md:grid-cols-3">
    {
      workApproach.map((item, i) => (
        <article
          data-tilt
          style={`--reveal-delay: ${i * 110}ms;`}
          class="group reveal spotlight-card flex flex-col justify-between rounded-3xl border border-line bg-surface-2 p-7 shadow-sm hover:shadow-xl hover:shadow-indigo-500/5"
        >
          <!-- Large Background Step Number Watermark -->
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-3 right-4 select-none font-display text-7xl font-bold tracking-tighter text-slate-900/[0.04] transition-all duration-300 group-hover:scale-110 group-hover:text-indigo-500/10 dark:text-white/[0.04] dark:group-hover:text-indigo-400/15"
          >
            {`0${i + 1}`}
          </span>

          <div>
            <div class="flex items-center justify-between">
              <span
                class={`inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br ${accentColors[i] ?? accentColors[0]} ring-1 ring-current/20 transition-transform duration-300 group-hover:scale-110`}
              >
                <Icon name={approachIcons[i] ?? 'sparkles'} class="h-6 w-6" />
              </span>
              <span class="rounded-full border border-line bg-surface px-3 py-1 font-mono text-xs font-semibold text-ink-3">
                STEP 0{i + 1}
              </span>
            </div>

            <h3 class="mt-6 font-display text-xl font-bold text-ink transition-colors group-hover:text-indigo-600 dark:group-hover:text-indigo-300">
              {item.title[lang]}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-3">
              {item.body[lang]}
            </p>
          </div>

          <div class="mt-6 flex items-center gap-2 pt-4 border-t border-line">
            <span class="h-1.5 w-1.5 rounded-full bg-indigo-500"></span>
            <span class="font-mono text-xs text-ink-4">
              {i === 0
                ? lang === 'th'
                  ? 'AI Partner + Architecture'
                  : 'AI Partner + Architecture'
                : i === 1
                  ? lang === 'th'
                    ? 'Agentic CLI & Automation'
                    : 'Agentic CLI & Automation'
                  : lang === 'th'
                    ? 'Right Tool for the Job'
                    : 'Right Tool for the Job'}
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
