---
import SectionHeading from './SectionHeading.astro';
import { workApproach } from '../data/site';
---

<section id="approach" class="mx-auto max-w-6xl px-6 py-24">
  <div class="reveal">
    <SectionHeading
      eyebrow="How I Work · แนวทางการทำงาน"
      title="My working approach"
      description="The mindset and workflows I bring to every project."
    />
  </div>

  <div class="grid gap-6 md:grid-cols-3">
    {
      workApproach.map((item, i) => (
        <article
          class="reveal rounded-2xl border border-line bg-surface-2 p-7 transition-colors hover:border-white/20"
        >
          <span class="font-display text-sm font-semibold text-indigo-400">{`0${i + 1}`}</span>
          <h3 class="mt-3 font-display text-lg font-semibold text-white">{item.title.en}</h3>
          <p class="mt-1 text-sm font-medium text-indigo-300/90">{item.title.th}</p>
          <p class="mt-4 text-sm leading-relaxed text-slate-400">{item.body.en}</p>
          <p class="mt-3 text-sm leading-relaxed text-slate-500">{item.body.th}</p>
        </article>
      ))
    }
  </div>
</section>
