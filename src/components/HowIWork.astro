---
import SectionHeading from './SectionHeading.astro';
import { workApproach } from '../data/site';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section id="approach" class="mx-auto max-w-6xl px-6 py-24">
  <div class="reveal">
    <SectionHeading
      eyebrow={t.howIWork.eyebrow}
      title={t.howIWork.title}
      description={t.howIWork.description}
    />
  </div>

  <div class="grid gap-6 md:grid-cols-3">
    {
      workApproach.map((item, i) => (
        <article
          class="reveal rounded-2xl border border-line bg-surface-2 p-7 transition-all hover:-translate-y-1 hover:border-slate-900/20 dark:hover:border-white/20"
        >
          <span class="font-display text-sm font-semibold text-indigo-600 dark:text-indigo-400">{`0${i + 1}`}</span>
          <h3 class="mt-3 font-display text-lg font-semibold text-ink">{item.title[lang]}</h3>
          <p class="mt-4 text-sm leading-relaxed text-ink-3">{item.body[lang]}</p>
        </article>
      ))
    }
  </div>
</section>
