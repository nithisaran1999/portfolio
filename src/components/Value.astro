---
import SectionHeading from './SectionHeading.astro';
import { valuePoints } from '../data/site';
---

<section id="value" class="border-y border-line bg-surface-2/50">
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="reveal">
      <SectionHeading
        eyebrow="Value I Deliver · สิ่งที่ส่งมอบ"
        title="What I bring to the team"
        description="The impact I deliver to teams and organizations."
      />
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {
        valuePoints.map((item) => (
          <article
            class="reveal rounded-2xl border border-line bg-surface p-7 transition-colors hover:border-white/20"
          >
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-500/15 text-indigo-400">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                <path d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <h3 class="mt-4 font-display text-lg font-semibold text-white">{item.title.en}</h3>
            <p class="mt-1 text-sm font-medium text-indigo-300/90">{item.title.th}</p>
            <p class="mt-4 text-sm leading-relaxed text-slate-400">{item.body.en}</p>
            <p class="mt-3 text-sm leading-relaxed text-slate-500">{item.body.th}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
