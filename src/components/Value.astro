---
import SectionHeading from './SectionHeading.astro';
import { valuePoints } from '../data/site';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section id="value" class="border-y border-line bg-surface-2/50">
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="reveal">
      <SectionHeading
        eyebrow={t.value.eyebrow}
        title={t.value.title}
        description={t.value.description}
      />
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {
        valuePoints.map((item) => (
          <article
            class="reveal rounded-2xl border border-line bg-surface p-7 transition-all hover:-translate-y-1 hover:border-slate-900/20 dark:hover:border-white/20"
          >
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-500/15 text-indigo-600 dark:text-indigo-400">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                <path d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <h3 class="mt-4 font-display text-lg font-semibold text-ink">{item.title[lang]}</h3>
            <p class="mt-4 text-sm leading-relaxed text-ink-3">{item.body[lang]}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
