---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="mb-12 max-w-2xl">
  <div class="mb-3.5 inline-flex items-center gap-2 rounded-full border border-indigo-500/25 bg-indigo-500/10 px-3.5 py-1 text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:border-indigo-400/25 dark:bg-indigo-400/10 dark:text-indigo-300">
    <span class="h-1.5 w-1.5 rounded-full bg-indigo-500 dark:bg-indigo-400"></span>
    {eyebrow}
  </div>
  <h2 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
    {title}
  </h2>
  {
    description && <p class="mt-4 text-lg leading-relaxed text-ink-3">{description}</p>
  }
</div>
