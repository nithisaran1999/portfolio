---
import Icon, { type IconName } from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { site, aboutMe } from '../data/site';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

const goodAtIcons: IconName[] = ['layers', 'cpu', 'zap'];
const statCards: { label: string; value: string; icon: IconName; accent: string }[] = [
  {
    label: t.about.location,
    value: site.location[lang],
    icon: 'location',
    accent: 'text-indigo-600 bg-indigo-500/12 dark:text-indigo-400',
  },
  {
    label: t.about.focus,
    value: t.about.focusValue,
    icon: 'sparkles',
    accent: 'text-violet-600 bg-violet-500/12 dark:text-violet-400',
  },
  {
    label: t.about.experience,
    value: t.about.experienceValue,
    icon: 'briefcase',
    accent: 'text-cyan-600 bg-cyan-500/12 dark:text-cyan-400',
  },
];
---

<section id="about" class="relative mx-auto max-w-6xl px-6 py-24">
  <div class="grid gap-12 lg:grid-cols-[1.15fr_1fr] lg:items-center">
    <div class="reveal">
      <SectionHeading
        eyebrow={t.about.eyebrow}
        title={site.role[lang]}
        description={aboutMe.description[lang]}
      />

      <dl class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
        {
          statCards.map((stat, i) => (
            <div
              class="spotlight-card rounded-2xl border border-line bg-surface-2 p-5 shadow-xs transition-all hover:-translate-y-1"
              style={`--reveal-delay: ${i * 80}ms;`}
            >
              <div class={`mb-3 inline-flex h-9 w-9 items-center justify-center rounded-xl ${stat.accent}`}>
                <Icon name={stat.icon} class="h-4 w-4" />
              </div>
              <dt class="text-xs font-medium uppercase tracking-wider text-ink-4">{stat.label}</dt>
              <dd class="mt-1 font-display text-base font-bold text-ink">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div
      data-tilt
      class="reveal spotlight-card rounded-3xl border border-line bg-gradient-to-br from-surface-2 via-surface-2 to-surface-3 p-8 shadow-xl shadow-black/5 dark:shadow-black/30"
      style="--reveal-delay: 140ms;"
    >
      <div class="flex items-center justify-between border-b border-line pb-5">
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600 text-white shadow-md shadow-indigo-500/25">
            <Icon name="code" class="h-5 w-5" />
          </span>
          <h3 class="font-display text-xl font-bold text-ink">{t.about.whatImGoodAt}</h3>
        </div>
        <span class="rounded-full border border-indigo-500/25 bg-indigo-500/10 px-3 py-1 font-mono text-xs font-semibold text-indigo-600 dark:text-indigo-300">
          CORE
        </span>
      </div>

      <ul class="mt-6 space-y-4">
        {
          t.about.goodAt.map((item, idx) => (
            <li class="group flex gap-4 rounded-2xl border border-transparent bg-surface/60 p-4 transition-all hover:border-line hover:bg-surface">
              <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-indigo-500/12 text-indigo-600 transition-transform duration-300 group-hover:scale-110 group-hover:bg-indigo-500 group-hover:text-white dark:text-indigo-400">
                <Icon name={goodAtIcons[idx] ?? 'check'} class="h-5 w-5" />
              </span>
              <div>
                <p class="font-display font-semibold text-ink">{item.title}</p>
                <p class="mt-1 text-sm leading-relaxed text-ink-3">{item.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
