---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { experience } from '../data/site';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section id="experience" class="relative border-y border-line bg-surface-2/40">
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="reveal">
      <SectionHeading
        eyebrow={t.experience.eyebrow}
        title={t.experience.title}
        description={t.experience.description}
      />
    </div>

    <div class="relative ml-3 md:ml-6">
      <!-- Glowing vertical timeline line -->
      <div
        aria-hidden="true"
        class="absolute top-2 bottom-2 left-0 w-0.5 bg-gradient-to-b from-indigo-500 via-violet-500/60 to-transparent"
      ></div>

      <ol class="space-y-8 pl-8 md:pl-10">
        {
          experience.map((job, idx) => {
            const isCurrent = idx === 0;
            return (
              <li
                style={`--reveal-delay: ${idx * 120}ms;`}
                class="reveal relative"
              >
                <!-- Glowing Timeline Node -->
                <span
                  class="absolute -left-[2.55rem] md:-left-[3.05rem] top-6 flex h-5 w-5 items-center justify-center rounded-full border-2 border-indigo-500 bg-surface shadow-[0_0_12px_rgba(99,102,241,0.6)]"
                  aria-hidden="true"
                >
                  {isCurrent && (
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-indigo-400 opacity-75" />
                  )}
                  <span class="relative h-2 w-2 rounded-full bg-indigo-500 dark:bg-indigo-400" />
                </span>

                <div class="spotlight-card rounded-3xl border border-line bg-surface p-7 shadow-xs transition-all hover:-translate-y-0.5">
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-500/12 text-indigo-600 dark:text-indigo-400">
                        <Icon name="briefcase" class="h-5 w-5" />
                      </span>
                      <div>
                        <h3 class="font-display text-lg font-bold text-ink sm:text-xl">
                          {job.role[lang]}
                        </h3>
                        <p class="text-sm font-semibold text-indigo-600 dark:text-indigo-300">
                          {job.companyUrl ? (
                            <a
                              href={job.companyUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="inline-flex items-center gap-1 hover:underline"
                            >
                              {job.company[lang]}
                              <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
                            </a>
                          ) : (
                            job.company[lang]
                          )}
                        </p>
                      </div>
                    </div>

                    <span
                      class={`inline-flex items-center gap-1.5 rounded-full px-3.5 py-1 font-mono text-xs font-semibold ${
                        isCurrent
                          ? 'border border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300'
                          : 'border border-line bg-surface-2 text-ink-3'
                      }`}
                    >
                      {isCurrent && (
                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 dark:bg-emerald-400" />
                      )}
                      {job.period[lang]}
                    </span>
                  </div>

                  <p class="mt-4 max-w-3xl text-sm leading-relaxed text-ink-3 sm:text-base">
                    {job.description[lang]}
                  </p>

                  {job.highlights.length > 0 && (
                    <ul class="mt-4 max-w-2xl space-y-2 border-t border-line pt-4">
                      {job.highlights.map((highlight) => (
                        <li class="flex gap-3 text-sm text-ink-3">
                          <Icon
                            name="check"
                            class="mt-0.5 h-4 w-4 shrink-0 text-indigo-600 dark:text-indigo-400"
                          />
                          {highlight[lang]}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
  </div>
</section>
