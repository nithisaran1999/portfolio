---
import SectionHeading from './SectionHeading.astro';
import { experience } from '../data/site';
---

<section id="experience" class="border-y border-line bg-surface-2/50">
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="reveal">
      <SectionHeading
        eyebrow="Experience"
        title="Where I've worked"
        description="My career journey and the impact I've made along the way."
      />
    </div>

    <ol class="relative space-y-10 border-l border-line pl-8">
      {
        experience.map((job) => (
          <li class="reveal relative">
            <span
              class="absolute -left-[2.42rem] top-1.5 flex h-4 w-4 items-center justify-center rounded-full border border-indigo-400 bg-surface"
              aria-hidden="true"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-indigo-400"></span>
            </span>

            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="font-display text-lg font-semibold text-white">{job.role}</h3>
              <span class="text-sm font-medium text-slate-500">{job.period}</span>
            </div>
            <p class="mt-1 text-sm font-medium text-indigo-300">{job.company}</p>
            <p class="mt-3 max-w-2xl leading-relaxed text-slate-400">{job.description}</p>

            <ul class="mt-4 max-w-2xl space-y-2">
              {
                job.highlights.map((highlight) => (
                  <li class="flex gap-3 text-sm text-slate-400">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="mt-0.5 h-4 w-4 shrink-0 text-indigo-400"
                      aria-hidden="true"
                    >
                      <path d="M5 13l4 4L19 7" />
                    </svg>
                    {highlight}
                  </li>
                ))
              }
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>
