---
import Icon, { type IconName } from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { projects } from '../data/site';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

const bannerThemes: {
  gradient: string;
  glow: string;
  icon: IconName;
  tag: string;
}[] = [
  {
    gradient: 'from-indigo-600/20 via-violet-600/15 to-cyan-500/10',
    glow: 'bg-indigo-500/30',
    icon: 'layers',
    tag: 'HEALTHCARE WEB APP',
  },
  {
    gradient: 'from-cyan-600/20 via-blue-600/15 to-indigo-500/10',
    glow: 'bg-cyan-500/30',
    icon: 'cpu',
    tag: 'ENTERPRISE SYSTEM',
  },
  {
    gradient: 'from-sky-600/20 via-blue-600/15 to-teal-500/10',
    glow: 'bg-sky-500/30',
    icon: 'cloud',
    tag: 'AVIATION WEATHER',
  },
  {
    gradient: 'from-amber-600/20 via-orange-600/15 to-rose-500/10',
    glow: 'bg-amber-500/30',
    icon: 'shield-check',
    tag: 'DOCUMENT MANAGEMENT',
  },
  {
    gradient: 'from-violet-600/20 via-fuchsia-600/15 to-indigo-500/10',
    glow: 'bg-violet-500/30',
    icon: 'terminal',
    tag: 'DEVELOPER TOOLING',
  },
  {
    gradient: 'from-emerald-600/20 via-teal-600/15 to-cyan-500/10',
    glow: 'bg-emerald-500/30',
    icon: 'compass',
    tag: 'DATA VISUALIZATION',
  },
];
---

<section id="projects" class="mx-auto max-w-6xl px-6 py-24">
  <div class="reveal">
    <SectionHeading
      eyebrow={t.projects.eyebrow}
      title={t.projects.title}
      description={t.projects.description}
    />
  </div>

  <div class="grid gap-7 md:grid-cols-2">
    {
      projects.map((project, i) => {
        const theme = bannerThemes[i % bannerThemes.length]!;
        const bannerTag = project.tag ?? theme.tag;
        const bannerIcon = (project.icon as IconName) ?? theme.icon;
        return (
          <article
            data-tilt
            style={`--reveal-delay: ${i * 110}ms;`}
            class="group reveal spotlight-card flex flex-col overflow-hidden rounded-3xl border border-line bg-surface-2 shadow-sm hover:shadow-2xl hover:shadow-indigo-500/10 dark:hover:shadow-black/50"
          >
            <!-- Decorative Visual Preview Header -->
            <div
              class={`relative flex h-40 items-center justify-between overflow-hidden border-b border-line bg-gradient-to-br ${theme.gradient} px-7`}
            >
              <!-- Grid pattern inside header -->
              <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,rgba(148,163,184,0.08)_1px,transparent_1px),linear-gradient(to_bottom,rgba(148,163,184,0.08)_1px,transparent_1px)] bg-[size:24px_24px]"
              />
              <div
                aria-hidden="true"
                class={`pointer-events-none absolute -right-8 -bottom-8 h-36 w-36 rounded-full ${theme.glow} blur-2xl transition-transform duration-500 group-hover:scale-125`}
              />

              <div class="relative z-10 flex items-center gap-3.5">
                <div class="flex h-13 w-13 items-center justify-center rounded-2xl border border-white/20 bg-surface/90 text-indigo-600 shadow-lg backdrop-blur-md transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3 dark:text-indigo-400">
                  <Icon name={bannerIcon} class="h-6 w-6" />
                </div>
                <div>
                  <span class="block font-mono text-[11px] font-semibold tracking-widest text-ink-3">
                    {bannerTag}
                  </span>
                  <span class="font-display text-xs font-medium text-ink-4">
                    Project 0{i + 1}
                  </span>
                </div>
              </div>

              <div class="relative z-10 flex items-center gap-2">
                {project.featured && (
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-indigo-500/30 bg-indigo-500/15 px-3 py-1 text-xs font-semibold text-indigo-600 backdrop-blur-md dark:text-indigo-300">
                    <Icon name="sparkles" class="h-3.5 w-3.5" />
                    {t.projects.featured}
                  </span>
                )}
              </div>
            </div>

            <!-- Card Body -->
            <div class="flex flex-1 flex-col p-7">
              <h3 class="font-display text-xl font-bold text-ink transition-colors group-hover:text-indigo-600 dark:group-hover:text-indigo-300">
                {project.title[lang]}
              </h3>

              <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-3 sm:text-base">
                {project.description[lang]}
              </p>

              <ul class="mt-6 flex flex-wrap gap-2">
                {project.tech.map((tech) => (
                  <li class="rounded-lg border border-line bg-surface px-3 py-1 font-mono text-xs font-medium text-ink-2">
                    {tech}
                  </li>
                ))}
              </ul>

              {(project.liveUrl || project.sourceUrl) && (
                <div class="mt-6 flex items-center gap-4 border-t border-line pt-5">
                  {project.liveUrl && (
                    <a
                      href={project.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group/link inline-flex items-center gap-1.5 rounded-xl bg-indigo-500/10 px-3.5 py-2 text-sm font-semibold text-indigo-600 transition-all hover:bg-indigo-500 hover:text-white dark:text-indigo-300"
                    >
                      <span>{t.projects.liveDemo}</span>
                      <Icon
                        name="arrow-up-right"
                        class="h-4 w-4 transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"
                      />
                    </a>
                  )}
                  {project.sourceUrl && (
                    <a
                      href={project.sourceUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 rounded-xl border border-line bg-surface px-3.5 py-2 text-sm font-medium text-ink-2 transition-colors hover:border-indigo-500/40 hover:text-ink dark:hover:text-white"
                    >
                      <Icon name="github" class="h-4 w-4" />
                      {t.projects.source}
                    </a>
                  )}
                </div>
              )}
            </div>
          </article>
        );
      })
    }
  </div>
</section>
