---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { projects } from '../data/site';
---

<section id="projects" class="mx-auto max-w-6xl px-6 py-24">
  <div class="reveal">
    <SectionHeading
      eyebrow="Projects"
      title="Things I've built"
      description="A selection of projects that show what I enjoy building and the problems I like to solve."
    />
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    {
      projects.map((project) => (
        <article
          class="group reveal flex flex-col rounded-2xl border border-line bg-surface-2 p-7 transition-all hover:-translate-y-1 hover:border-white/20 hover:shadow-xl hover:shadow-black/40"
        >
          <div class="flex items-start justify-between gap-4">
            <h3 class="font-display text-xl font-semibold text-white">{project.title}</h3>
            {
              project.featured && (
                <span class="shrink-0 rounded-full bg-indigo-500/15 px-3 py-1 text-xs font-medium text-indigo-300">
                  Featured
                </span>
              )
            }
          </div>

          <p class="mt-3 flex-1 leading-relaxed text-slate-400">{project.description}</p>

          <ul class="mt-5 flex flex-wrap gap-2">
            {
              project.tech.map((tech) => (
                <li class="rounded-md bg-white/5 px-2.5 py-1 font-mono text-xs text-slate-300 ring-1 ring-white/10">
                  {tech}
                </li>
              ))
            }
          </ul>

          <div class="mt-6 flex items-center gap-4 border-t border-line pt-5">
            {
              project.liveUrl && (
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-sm font-medium text-indigo-300 transition-colors hover:text-indigo-200"
                >
                  <Icon name="external" class="h-4 w-4" />
                  Live demo
                </a>
              )
            }
            {
              project.sourceUrl && (
                <a
                  href={project.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-300 transition-colors hover:text-white"
                >
                  <Icon name="github" class="h-4 w-4" />
                  Source
                </a>
              )
            }
          </div>
        </article>
      ))
    }
  </div>
</section>
